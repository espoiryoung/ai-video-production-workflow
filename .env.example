# Server only. Never expose these values in browser-side code.
HF_CREDENTIALS=your-key-id:your-key-secret
APP_PASSWORD=choose-a-long-password
SESSION_SECRET=choose-an-independent-random-secret

# Required after deployment so Higgsfield can fetch uploaded reference images.
# Example: https://video.example.com
APP_URL=http://localhost:3000
PORT=3000
TRUST_PROXY=false
